# Copy this file to `.env` and fill in your real values (`.env` is gitignored).
# Never commit the real `.env`.
GNANI_API_KEY=your-gnani-api-key
GNANI_BASE_URL=https://api.vachana.ai
GNANI_EVON_MODEL=evon

# --- Real hosted LLM reasoning (per-segment market mood) ---
# Provider is auto-detected from whichever key is present, or set explicitly:
#   GNANI_LLM_PROVIDER=openai | anthropic
# OpenAI:
#   OPENAI_API_KEY=sk-...
#   GNANI_LLM_MODEL=gpt-4o-mini        (optional override)
# Anthropic:
#   ANTHROPIC_API_KEY=sk-ant-...
#   GNANI_LLM_MODEL=claude-3-5-haiku-latest  (optional override)

# --- Free OpenAI-compatible providers (e.g. Groq or GitHub Models) ---
# Provider is auto-detected from whichever key is present, or set explicitly:
#   GNANI_LLM_PROVIDER=openai
# For Groq (console.groq.com -> API keys -> create key):
#   GNANI_LLM_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_API_KEY=gsk_...
#   GNANI_LLM_MODEL=llama-3.3-70b-versatile
# For GitHub Models (github.com/marketplace/models -> get a token):
#   GNANI_LLM_BASE_URL=https://models.inference.ai.azure.com
#   OPENAI_API_KEY=<github token>
#   GNANI_LLM_MODEL=gpt-4o-mini
